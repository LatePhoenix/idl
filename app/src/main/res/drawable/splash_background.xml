<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8-11 launch window: the wordmark centred at the same size as the Android 12+ splash icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/idl_splash_bg" />
    <item
        android:width="288dp"
        android:height="288dp"
        android:drawable="@drawable/splash_wordmark"
        android:gravity="center" />
</layer-list>
