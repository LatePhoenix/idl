<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".IdlApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Idl">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Idl.Starting"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="idl" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.SoloFriendWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Idl">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.SoloFriendWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_solo_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/solo_friend_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.SelfWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_self_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/self_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.WidgetPinnedReceiver"
            android:exported="false" />
    </application>
</manifest>
